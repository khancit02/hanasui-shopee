{
  "version": 2,
  "builds": [
    {
      "src": "server-v2.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["data/**", "knowledge.json", "lib/**"]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server-v2.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}